# No secret belongs in Git. Copy to .env on the ECS and fill the values there.
APP_EXTERNAL_URL=https://keystone.boliboliworld.cn
FRONTEND_PORT=18081
KEYSTONE_IMAGE_TAG=local
MAX_FILE_SIZE_MB=20
# Basic CPU-only DocReader. Do not enable ODL/MinerU on the 2C4G MVP host.
KEYSTONE_DOCREADER_TAG=latest
DOCREADER_APT_MIRROR=https://mirrors.aliyun.com
DOCREADER_MARKITDOWN_MAX_WORKERS=1
DOCREADER_PDF_RENDER_MAX_WORKERS=1
DOCREADER_PDF_RENDER_PARALLELISM=1
DOCREADER_PDF_RENDER_DPI=160
DOCREADER_PDF_JPEG_QUALITY=80
DOCREADER_PDF_RENDER_MAX_EDGE=1600
GOPROXY_ARG=https://goproxy.cn,direct
APK_MIRROR_ARG=mirrors.aliyun.com

# Private database inside this Compose project. Use unique random values.
DB_USER=keystone
DB_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
DB_NAME=keystone

# Existing Alibaba Cloud Tair instance. Use its VPC endpoint, never its public endpoint.
REDIS_ADDR=REPLACE_WITH_TAIR_VPC_ENDPOINT:6379
REDIS_USERNAME=default
REDIS_PASSWORD=REPLACE_WITH_TAIR_PASSWORD
REDIS_DB=0
REDIS_PREFIX=keystone:mvp:
REDIS_USE_TLS=false

# Alibaba Cloud OSS. Create a RAM user/access key with access limited to this bucket/prefix.
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_ACCESS_KEY=REPLACE_WITH_OSS_ACCESS_KEY
OSS_SECRET_KEY=REPLACE_WITH_OSS_SECRET_KEY
OSS_BUCKET_NAME=keystore001
OSS_PATH_PREFIX=keystone-mvp/
OSS_TEMP_BUCKET_NAME=
OSS_TEMP_REGION=

QDRANT_COLLECTION=keystone_embeddings
QDRANT_API_KEY=
QDRANT_USE_TLS=false

# Generate unique values; do not reuse local deployment keys.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
TENANT_AES_KEY=REPLACE_WITH_EXACTLY_32_BYTES
SYSTEM_AES_KEY=REPLACE_WITH_EXACTLY_32_BYTES
CRYPTO_MASTER_KEY=REPLACE_WITH_A_RANDOM_SECRET
CRYPTO_SALT=REPLACE_WITH_A_RANDOM_SECRET

# Start conservatively on the 2C4G MVP host.
KEYSTONE_MODEL_MAX_CONCURRENCY=1
KEYSTONE_ASYNQ_CORE_CONCURRENCY=1
KEYSTONE_ASYNQ_ENRICHMENT_CONCURRENCY=1
KEYSTONE_ASYNQ_MAINTENANCE_CONCURRENCY=1
KEYSTONE_ASYNQ_SHARED_CONCURRENCY=1
KEYSTONE_WIKI_ASYNQ_CONCURRENCY=1
