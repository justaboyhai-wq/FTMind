# Public entry. Use the final HTTPS domain once a reverse proxy is configured.
APP_EXTERNAL_URL=https://knowledge.example.com
FRONTEND_PORT=8080
KEYSTONE_IMAGE_TAG=local
MAX_FILE_SIZE_MB=50

# Build-only mirrors for networks that cannot reach Docker Hub or proxy.golang.org.
GOPROXY_ARG=https://goproxy.cn,direct
APK_MIRROR_ARG=mirrors.aliyun.com

# Fixed WireGuard addresses or private DNS names of local services.
# Do not use localhost or host.docker.internal from this cloud deployment.
DB_HOST=10.76.0.11
DB_PORT=5432
DB_USER=keystone
DB_PASSWORD=REPLACE_WITH_A_SECRET
DB_NAME=keystone

REDIS_ADDR=10.76.0.12:6379
REDIS_USERNAME=
REDIS_PASSWORD=REPLACE_WITH_A_SECRET
REDIS_DB=0

# Local MinIO/S3-compatible storage is required. `local` storage cannot be
# shared safely between this cloud App and a local DocReader.
MINIO_ENDPOINT=10.76.0.13:9000
MINIO_ACCESS_KEY_ID=REPLACE_WITH_A_SECRET
MINIO_SECRET_ACCESS_KEY=REPLACE_WITH_A_SECRET
MINIO_BUCKET_NAME=keystone

QDRANT_HOST=10.76.0.30
QDRANT_PORT=6334
QDRANT_COLLECTION=keystone_embeddings
QDRANT_API_KEY=
QDRANT_USE_TLS=false

DOCREADER_ADDR=10.76.0.14:50051
OLLAMA_BASE_URL=http://10.76.0.20:11434

# Keep the allowlist exact: only VPN peers or private service DNS names.
SSRF_WHITELIST=10.76.0.11,10.76.0.12,10.76.0.13,10.76.0.14,10.76.0.20,10.76.0.30
SSRF_WHITELIST_EXTRA=10.76.0.30

# Generate unique values with a password manager or `openssl rand -hex 32`.
JWT_SECRET=REPLACE_WITH_A_SECRET
TENANT_AES_KEY=REPLACE_WITH_A_SECRET
SYSTEM_AES_KEY=REPLACE_WITH_A_SECRET
CRYPTO_MASTER_KEY=REPLACE_WITH_A_SECRET
CRYPTO_SALT=REPLACE_WITH_A_SECRET

# Begin conservatively because every model/vector request crosses the VPN.
KEYSTONE_MODEL_MAX_CONCURRENCY=4
KEYSTONE_ASYNQ_CORE_CONCURRENCY=2
KEYSTONE_ASYNQ_ENRICHMENT_CONCURRENCY=2
KEYSTONE_ASYNQ_MAINTENANCE_CONCURRENCY=1
KEYSTONE_ASYNQ_SHARED_CONCURRENCY=1
KEYSTONE_WIKI_ASYNQ_CONCURRENCY=1
